---
import PublicLayout from '../../layouts/PublicLayout.astro';
import { NoticesArchiveViewer } from '../../components/NoticesArchiveViewer';

const breadcrumbs = [
  { label: 'Notices' },
];
---

<PublicLayout
  title="Notice Board & Circulars | MJ School Shahpur"
  description="Official administrative notices, examination schedules, and academic circulars from MJ School, Shahpur."
  breadcrumbs={breadcrumbs}
  pageTitle="Official Notice Board & Circulars"
  pageSubtitle="Stay informed with authentic circulars, examination schedules, academic notifications, and holiday declarations."
>
  <div class="py-12 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      {/* Dynamic Single-Source-of-Truth Notices Archive Viewer */}
      <NoticesArchiveViewer client:load />

      {/* Verification Notice */}
      <div class="bg-slate-50 border border-slate-200 rounded-xl p-5 text-xs text-slate-600 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          <p class="font-bold text-[#0B2545]">Official Dissemination Note:</p>
          <p class="text-[11px] text-slate-500 mt-0.5">
            All circulars published here are authenticated by the School Office. For emergency weather advisories, SMS and ERP app broadcasts will be deployed simultaneously.
          </p>
        </div>
        <a
          href="/faqs/"
          class="shrink-0 text-xs font-bold text-[#C59B27] hover:underline"
        >
          Read FAQs &amp; Helpdesk &rarr;
        </a>
      </div>

    </div>
  </div>
</PublicLayout>
