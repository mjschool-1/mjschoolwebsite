---
import PublicLayout from '../../layouts/PublicLayout.astro';
import { Calendar, CreditCard, Info } from 'lucide-react';

const breadcrumbs = [
  { label: 'Fees & Payment Structure', href: '/admissions/fee-structure/' },
  { label: 'Fee Payment 2026' },
];
---

<PublicLayout
  title="Fee Payment Portal 2026 | MJ School Shahpur"
  description="Fee payment information, installment schedule updates, and payment guidance for MJ School, Shahapur."
  breadcrumbs={breadcrumbs}
  pageTitle="Fee Payment Portal 2026"
  pageSubtitle="Information on approved payment schedules, fee policies, and official school updates."
>
  <div class="py-12 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      {/* Neutral Fee Payment Information Notice */}
      <div class="bg-slate-50 border border-slate-200 p-6 sm:p-8 mb-12">
        <div class="max-w-3xl">
          <div class="w-8 h-0.5 bg-[#C59B27] mb-3"></div>
          <span class="text-xs font-bold text-[#C59B27] tracking-wider uppercase block mb-1.5">
            Official Notice
          </span>
          <h2 class="text-xl sm:text-2xl font-bold font-serif text-[#0B2545] mb-2 leading-snug">
            Fee Payment Information
          </h2>
          <p class="text-xs sm:text-sm text-slate-700 leading-relaxed">
            Fee payment details for the upcoming academic session will be published here once confirmed by the school. Please contact the school office for current fee-related enquiries.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start mb-12">
        
        {/* Left: Quarterly Due Calendar */}
        <div class="lg:col-span-7 space-y-6">
          <div class="bg-white border border-slate-200 p-6 sm:p-8">
            <div class="w-8 h-0.5 bg-[#C59B27] mb-3"></div>
            <h3 class="text-lg sm:text-xl font-bold font-serif text-[#0B2545] mb-3 flex items-center gap-2">
              <Calendar class="w-5 h-5 text-[#C59B27]" />
              Quarterly Installment Schedule
            </h3>
            <p class="text-xs sm:text-sm text-slate-700 leading-relaxed mb-6">
              The installment schedule will be updated once the school finalizes and publishes the fee details.
            </p>

            <div class="bg-slate-50 border border-slate-200 p-5 text-xs text-slate-600 leading-relaxed">
              <p class="font-bold text-[#0B2545] mb-1">
                Installment Schedule Status: Pending School Publication
              </p>
              <p>
                Once approved, the complete quarterly timeline and official payment schedule will be displayed in this section.
              </p>
            </div>
          </div>
        </div>

        {/* Right: Payment Information & Fee Structure Link */}
        <div class="lg:col-span-5 space-y-6">
          <div class="bg-white border border-slate-200 p-6 sm:p-8">
            <div class="w-8 h-0.5 bg-[#C59B27] mb-3"></div>
            <h3 class="text-lg sm:text-xl font-bold font-serif text-[#0B2545] mb-3 flex items-center gap-2">
              <CreditCard class="w-5 h-5 text-[#C59B27]" />
              Payment Information
            </h3>
            <p class="text-xs sm:text-sm text-slate-700 leading-relaxed mb-6">
              Available payment methods will be announced by the school. Please confirm the accepted payment options with the school office before making a payment.
            </p>

            <div class="bg-slate-50 border border-slate-200 p-4 text-xs text-slate-600 leading-relaxed">
              <p class="font-bold text-[#0B2545] mb-1">
                School Office Assistance
              </p>
              <p>
                For verified payment guidance and administrative assistance, please connect directly with the MJ School accounts office.
              </p>
            </div>
          </div>

          <div class="bg-slate-50 border border-slate-200 p-6 text-xs text-slate-700">
            <h4 class="font-bold text-sm mb-1 text-[#0B2545] font-serif">
              Looking for Fee Structure Details?
            </h4>
            <p class="text-slate-600 mb-4 leading-relaxed">
              View the official fee structure guidelines and policy updates.
            </p>
            <a
              href="/admissions/fee-structure/"
              class="inline-block bg-[#0B2545] hover:bg-[#133E6E] text-white font-bold py-2.5 px-4 text-xs uppercase tracking-wider transition-colors"
            >
              Go to Fee Structure &rarr;
            </a>
          </div>
        </div>

      </div>

    </div>
  </div>
</PublicLayout>

