---
import PublicLayout from '../../layouts/PublicLayout.astro';
import { FeeStructureSection } from '../../components/FeeStructureSection';

const breadcrumbs = [
  { label: 'Fees & Payment Structure', href: '/admissions/fee-structure/' },
  { label: 'Fee Structure' },
];
---

<PublicLayout
  title="Fee Structure & Regulations | MJ School Shahpur"
  description="Official fee structure guidelines, grade-wise schedule template, and regulations for MJ School, Shahapur."
  breadcrumbs={breadcrumbs}
  pageTitle="Fee Structure & Regulations"
  pageSubtitle="Approved by the School Managing Committee (SMC) in adherence to the Maharashtra Educational Institutions (Regulation of Fee) Act."
>
  <div class="bg-white">
    {/* Mount existing interactive Fee Structure & Calculator Section */}
    <FeeStructureSection client:visible />
  </div>
</PublicLayout>
