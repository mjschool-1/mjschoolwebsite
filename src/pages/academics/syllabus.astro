---
import PublicLayout from '../../layouts/PublicLayout.astro';
import { AcademicSyllabusTable } from '../../components/AcademicSyllabusTable';

const breadcrumbs = [
  { label: 'Academics', href: '/academics/syllabus/' },
  { label: 'Academic Syllabus' },
];
---

<PublicLayout
  title="Academic Syllabus | MJ School Shahpur"
  description="Explore the subjects taught at each grade at MJ School, Shahpur."
  breadcrumbs={breadcrumbs}
  pageTitle="Academic Syllabus"
  pageSubtitle="Explore the subjects taught at each grade at MJ School."
  pageKey="syllabus"
>
  <div class="py-12 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      {/* Grade-wise Academic Syllabus Table */}
      <AcademicSyllabusTable client:load />

    </div>
  </div>
</PublicLayout>
