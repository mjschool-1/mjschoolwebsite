---
import PublicLayout from '../../layouts/PublicLayout.astro';
import { AcademicSyllabusTable } from '../../components/AcademicSyllabusTable';

const breadcrumbs = [
  { label: 'Academics', href: '/academics/syllabus/' },
  { label: 'Academic Syllabus' },
];
---

<PublicLayout
  title="Academic Syllabus | MJ School Shahapur"
  description="Explore the subjects taught at each grade at MJ School, Shahapur."
  breadcrumbs={breadcrumbs}
  pageTitle="Academic Syllabus"
  pageSubtitle="Explore the subjects taught at each grade at MJ School."
  pageKey="syllabus"
  hideBannerText={true}
>
  {/* Unified Heading Section immediately below the banner frame for Desktop, Tablet, and Mobile */}
  <section class="bg-white border-b border-slate-200/80 px-4 py-8 sm:py-10 md:py-12 text-center select-none">
    <div class="max-w-3xl mx-auto space-y-3 sm:space-y-3.5">
      {/* 1. Breadcrumb path: centered, smaller and less prominent than title, dark navy / slate text */}
      <nav aria-label="Breadcrumb">
        <ol class="flex flex-wrap items-center justify-center gap-1.5 sm:gap-2 text-xs sm:text-sm text-slate-500 font-medium">
          <li>
            <a href="/" class="hover:text-[#0B2545] text-slate-500 transition-colors">Home</a>
          </li>
          <li class="flex items-center gap-1.5 sm:gap-2">
            <span class="text-[#C59B27] font-bold">→</span>
            <a href="/academics/syllabus/" class="hover:text-[#0B2545] text-slate-600 transition-colors">Academics</a>
          </li>
          <li class="flex items-center gap-1.5 sm:gap-2">
            <span class="text-[#C59B27] font-bold">→</span>
            <span class="text-[#0B2545] font-semibold">Academic Syllabus</span>
          </li>
        </ol>
      </nav>

      {/* 2. Page Title: Bold, elegant, visually prominent in dark navy blue */}
      <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold font-serif tracking-tight text-[#0B2545] leading-tight">
        Academic Syllabus
      </h1>

      {/* Subtle brand accent separator */}
      <div class="w-12 h-1 bg-[#C59B27] rounded-full mx-auto my-2" aria-hidden="true" />

      {/* 3. Subtitle: Readable with comfortable line spacing in dark text */}
      <p class="text-xs sm:text-sm md:text-base text-slate-600 leading-relaxed font-normal max-w-xl mx-auto">
        Explore the subjects taught at each grade at MJ School.
      </p>
    </div>
  </section>

  <div class="py-8 sm:py-12 md:py-16 bg-[#F8FAFC]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      {/* Grade-wise Academic Syllabus Table */}
      <AcademicSyllabusTable client:load />

    </div>
  </div>
</PublicLayout>
