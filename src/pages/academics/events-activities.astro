---
import PublicLayout from '../../layouts/PublicLayout.astro';
import { Calendar, Sparkles } from 'lucide-react';

const breadcrumbs = [
  { label: 'Academics', href: '/academics/syllabus/' },
  { label: 'Events & Activities' },
];
---

<PublicLayout
  title="Events & Activities | MJ School Shahapur"
  description="Discover upcoming events, annual celebrations, and co-curricular activities at MJ School, Shahapur."
  breadcrumbs={breadcrumbs}
  pageTitle="Events & Co-Curricular Activities"
  pageSubtitle="Fostering leadership, sportsmanship, and creative expression through student activities and school celebrations."
  pageKey="events_activities"
>
  <div class="py-10 sm:py-14 md:py-16 bg-[#F8FAFC]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      
      {/* General Co-Curricular Overview */}
      <div class="bg-white border border-slate-200/80 rounded-2xl p-6 sm:p-8 mb-8 text-center sm:text-left shadow-xs">
        <div class="max-w-3xl">
          <div class="flex items-center gap-2 mb-2.5 justify-center sm:justify-start">
            <Sparkles class="w-4 h-4 text-[#C59B27]" />
            <span class="text-xs font-bold uppercase tracking-wider text-[#C59B27]">Co-Curricular Life at MJ School</span>
          </div>
          <h2 class="text-xl sm:text-2xl font-bold font-serif text-[#0B2545] mb-2.5">
            Nurturing Talents Beyond the Classroom
          </h2>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
            At MJ School, co-curricular learning, sportsmanship, and creative expression are integral pillars of a well-rounded educational journey. We provide students with avenues to explore their interests, develop leadership capabilities, and collaborate with peers through school-wide activities.
          </p>
        </div>
      </div>

      {/* Verified Events & Activities State: Professional Empty State */}
      <div class="bg-white border border-slate-200/90 rounded-2xl p-8 sm:p-14 text-center shadow-xs">
        <div class="w-16 h-16 rounded-2xl bg-amber-50/90 border border-amber-200/80 flex items-center justify-center mx-auto mb-5 text-[#C59B27] shadow-2xs">
          <Calendar class="w-8 h-8 text-[#C59B27]" />
        </div>

        <h3 class="text-xl sm:text-2xl font-bold font-serif text-[#0B2545] mb-2 sm:mb-3">
          No Events to Display
        </h3>

        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed max-w-md mx-auto mb-6">
          Event announcements and updates will be published here when available. Please check back for the latest school activities.
        </p>

        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-slate-50 border border-slate-200 text-xs text-slate-500 font-medium">
          <span class="w-2 h-2 rounded-full bg-[#C59B27] shrink-0 animate-pulse"></span>
          <span>Official schedules and announcements will be posted here</span>
        </div>

        <div class="mt-8 pt-6 border-t border-slate-100 flex flex-col sm:flex-row items-center justify-center gap-3">
          <span class="text-xs text-slate-500">Looking for administrative circulars and datesheets?</span>
          <a
            href="/notices/"
            class="inline-flex items-center gap-1.5 text-xs font-bold text-[#0B2545] hover:text-[#C59B27] transition-colors"
          >
            <span>Visit School Notice Board</span>
            <span>→</span>
          </a>
        </div>
      </div>

    </div>
  </div>
</PublicLayout>
