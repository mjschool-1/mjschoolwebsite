---
import PublicLayout from '../../layouts/PublicLayout.astro';
import { GalleryViewer } from '../../components/GalleryViewer';

const breadcrumbs = [
  { label: 'Gallery' },
];

const galleryItems = [
  {
    title: 'Everyday Learning',
    image: 'https://images.unsplash.com/photo-1580582932707-520aed937b7b?auto=format&fit=crop&w=2000&q=90',
    alt: 'Everyday Learning in the classroom at MJ School',
  },
  {
    title: 'Learning Beyond Books',
    image: 'https://images.unsplash.com/photo-1460661419201-fd4cecdf8a8b?auto=format&fit=crop&w=2000&q=90',
    alt: 'Children participating in creative activities and learning beyond books at MJ School',
  },
  {
    title: 'Rooted in Indian Values',
    image: 'https://images.unsplash.com/photo-1532375810709-75b1da00537c?auto=format&fit=crop&w=2000&q=90',
    alt: 'Traditional celebrations and activities rooted in Indian values at MJ School',
  },
];
---

<PublicLayout
  title="Moments at MJ School | MJ School Shahpur"
  description="A glimpse into learning, creativity, and the values that shape everyday school life at MJ School, Shahapur."
  breadcrumbs={breadcrumbs}
  pageTitle="Moments at MJ School"
  pageSubtitle="A glimpse into learning, creativity, and the values that shape everyday school life at MJ School, Shahapur."
>
  <div class="py-12 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      {/* Interactive 3-Card Gallery Grid with Full-Resolution Lightbox */}
      <GalleryViewer client:load items={galleryItems} />
    </div>
  </div>
</PublicLayout>


