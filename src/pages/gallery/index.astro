---
import PublicLayout from '../../layouts/PublicLayout.astro';
import { GalleryViewer } from '../../components/GalleryViewer';

const breadcrumbs = [
  { label: 'Gallery' },
];

const galleryItems = [
  {
    title: 'Everyday Learning',
    image: '',
    alt: 'Everyday Learning at MJ School',
  },
  {
    title: 'Learning Beyond Books',
    image: '',
    alt: 'Learning Beyond Books at MJ School',
  },
  {
    title: 'Rooted in Indian Values',
    image: '',
    alt: 'Rooted in Indian Values at MJ School',
  },
];
---

<PublicLayout
  title="Moments at MJ School | MJ School Shahpur"
  description="A glimpse into learning, creativity, and the values that shape everyday school life at MJ School, Shahapur."
  breadcrumbs={breadcrumbs}
  pageTitle="Moments at MJ School"
  pageSubtitle="A glimpse into learning, creativity, and the values that shape everyday school life at MJ School, Shahapur."
  pageKey="gallery"
>
  <div class="py-12 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      {/* Interactive 3-Card Gallery Grid with Full-Resolution Lightbox */}
      <GalleryViewer client:load items={galleryItems} />
    </div>
  </div>
</PublicLayout>


