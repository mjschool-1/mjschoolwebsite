---
import PublicLayout from '../../layouts/PublicLayout.astro';

const breadcrumbs = [
  { label: 'Gallery' },
];

const galleryItems = [
  {
    eyebrow: '01 · CAMPUS LIFE',
    title: 'Everyday Learning',
    description: 'A strong start begins in the classroom. We focus on building foundational skills, encouraging curiosity, and helping children learn with confidence.',
    image: 'https://images.unsplash.com/photo-1580582932707-520aed937b7b?auto=format&fit=crop&w=800&q=80',
    alt: 'Everyday classroom learning at MJ School',
  },
  {
    eyebrow: '02 · CREATIVE ACTIVITIES',
    title: 'Learning Beyond Books',
    description: 'Through art, competitions, recitation, singing, and hands-on activities, children discover their interests and develop self-expression.',
    image: 'https://images.unsplash.com/photo-1460661419201-fd4cecdf8a8b?auto=format&fit=crop&w=800&q=80',
    alt: 'Children participating in creative activities and art',
  },
  {
    eyebrow: '03 · CULTURE & VALUES',
    title: 'Rooted in Indian Values',
    description: 'Festival celebrations, shloka competitions, and cultural activities help children appreciate Indian traditions, respect, and togetherness.',
    image: 'https://images.unsplash.com/photo-1532375810709-75b1da00537c?auto=format&fit=crop&w=800&q=80',
    alt: 'Cultural celebrations and traditional values at MJ School',
  },
];
---

<PublicLayout
  title="Moments at MJ School | MJ School Shahpur"
  description="A glimpse into learning, creativity, and the values that shape everyday school life at MJ School, Shahapur."
  breadcrumbs={breadcrumbs}
  pageTitle="Moments at MJ School"
  pageSubtitle="A glimpse into learning, creativity, and the values that shape everyday school life at MJ School, Shahapur."
>
  <div class="py-12 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      {/* Exactly Three Gallery Tiles */}
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
        {galleryItems.map((item) => (
          <div class="bg-white border border-slate-200 flex flex-col justify-between hover:border-slate-300 transition-colors">
            {/* Image */}
            <div class="w-full aspect-[16/10] sm:aspect-[4/3] overflow-hidden bg-slate-100 border-b border-slate-200">
              <img
                src={item.image}
                alt={item.alt}
                class="w-full h-full object-cover"
                loading="lazy"
              />
            </div>

            {/* Content Area */}
            <div class="p-6 sm:p-7 flex-1 flex flex-col justify-start">
              <div class="w-8 h-0.5 bg-[#C59B27] mb-3"></div>
              <span class="text-xs font-bold text-[#C59B27] tracking-wider uppercase block mb-1.5">
                {item.eyebrow}
              </span>
              <h2 class="text-lg sm:text-xl font-bold font-serif text-[#0B2545] mb-2.5 leading-snug">
                {item.title}
              </h2>
              <p class="text-xs sm:text-sm text-slate-700 leading-relaxed">
                {item.description}
              </p>
            </div>
          </div>
        ))}
      </div>

    </div>
  </div>
</PublicLayout>

