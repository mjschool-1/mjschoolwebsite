---
import PublicLayout from '../../layouts/PublicLayout.astro';
import { FacilitiesGrid } from '../../components/FacilitiesGrid';

const breadcrumbs = [
  { label: 'Facilities' },
];
---

<PublicLayout
  title="Our School Facilities | MJ School Shahpur"
  description="A welcoming environment for learning, play, creativity, and all-round development at MJ School, Shahapur."
  breadcrumbs={breadcrumbs}
  pageTitle="Our School Facilities"
  pageSubtitle="A welcoming environment for learning, play, creativity, and all-round development at MJ School, Shahapur."
  pageKey="facilities"
>
  <div class="py-12 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      {/* Four Simplified Facilities Cards Grid with Dynamic Image Frames */}
      <FacilitiesGrid client:load />

      {/* Campus Tour CTA */}
      <div class="bg-gradient-to-r from-slate-50 to-amber-50/50 border border-slate-200 p-6 sm:p-8 flex flex-col sm:flex-row items-center justify-between gap-6 text-center sm:text-left">
        <div>
          <h3 class="text-lg font-bold font-serif text-[#0B2545]">
            Experience Our Campus In Person
          </h3>
          <p class="text-xs text-slate-600 mt-1 max-w-xl">
            We invite prospective parents and students for an interactive campus walkthrough during official visiting hours.
          </p>
        </div>
        <a
          href="/admissions/2026/"
          class="shrink-0 bg-[#0B2545] hover:bg-[#133E6E] text-white font-bold text-xs uppercase px-5 py-2.5 shadow-sm transition-all"
        >
          Book an Admission Visit
        </a>
      </div>

    </div>
  </div>
</PublicLayout>

