---
import PublicLayout from '../../layouts/PublicLayout.astro';

const breadcrumbs = [
  { label: 'Facilities' },
];

const facilities = [
  {
    title: 'Classrooms & Learning Spaces',
    desc: 'Comfortable classroom spaces where children develop essential academic skills, explore new concepts, and build confidence through everyday learning.',
    tags: ['CLASSROOM LEARNING', 'ACADEMIC FOUNDATIONS'],
  },
  {
    title: 'Cleanliness & Hygiene',
    desc: 'Essential sanitary facilities and an emphasis on personal hygiene help children develop healthy everyday habits.',
    tags: ['HYGIENE', 'HEALTHY HABITS'],
  },
  {
    title: 'Early Years Play & Swimming',
    desc: 'Opportunities for play and physical activity support the development of coordination, confidence, and active habits. A small swimming pool is planned for Junior and Senior KG children.',
    tags: ['KINDERGARTEN', 'PHYSICAL DEVELOPMENT'],
  },
  {
    title: 'Indian Values & Traditions',
    desc: 'Our Saraswati Devi statue and dedicated flagpole area reflect the importance of knowledge, respect, cultural heritage, and national pride in school life.',
    tags: ['INDIAN CULTURE', 'VALUE-BASED LEARNING'],
  },
];
---

<PublicLayout
  title="Our School Facilities | MJ School Shahpur"
  description="A welcoming environment for learning, play, creativity, and all-round development at MJ School, Shahapur."
  breadcrumbs={breadcrumbs}
  pageTitle="Our School Facilities"
  pageSubtitle="A welcoming environment for learning, play, creativity, and all-round development at MJ School, Shahapur."
>
  <div class="py-12 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      {/* Four Simplified Facilities Cards Grid with Empty Image Placeholders */}
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
        {facilities.map((facility) => (
          <div class="bg-white border border-slate-200 flex flex-col justify-between hover:border-slate-300 transition-colors">
            {/* Flat Rectangular Image Placeholder at Top (16:9 aspect ratio, clean empty space) */}
            <div class="w-full aspect-[16/9] bg-slate-100 border-b border-slate-200"></div>

            {/* Content Body */}
            <div class="p-6 sm:p-7 flex-1 flex flex-col justify-between">
              <div>
                <div class="w-8 h-0.5 bg-[#C59B27] mb-3.5"></div>
                <h2 class="text-lg sm:text-xl font-bold text-[#0B2545] font-serif mb-3 leading-snug">
                  {facility.title}
                </h2>
                <p class="text-xs sm:text-sm text-slate-700 leading-relaxed mb-6">
                  {facility.desc}
                </p>
              </div>

              <div class="pt-4 border-t border-slate-100 flex flex-wrap gap-2">
                {facility.tags.map((tag) => (
                  <span class="text-[10px] font-bold text-[#0B2545] bg-slate-100 border border-slate-200/80 px-2.5 py-1 tracking-wider uppercase">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>

      {/* Campus Tour CTA */}
      <div class="bg-gradient-to-r from-slate-50 to-amber-50/50 border border-slate-200 p-6 sm:p-8 flex flex-col sm:flex-row items-center justify-between gap-6 text-center sm:text-left">
        <div>
          <h3 class="text-lg font-bold font-serif text-[#0B2545]">
            Experience Our Campus In Person
          </h3>
          <p class="text-xs text-slate-600 mt-1 max-w-xl">
            We invite prospective parents and students for an interactive campus walkthrough during official visiting hours.
          </p>
        </div>
        <a
          href="/admissions/2026/"
          class="shrink-0 bg-[#0B2545] hover:bg-[#133E6E] text-white font-bold text-xs uppercase px-5 py-2.5 shadow-sm transition-all"
        >
          Book an Admission Visit
        </a>
      </div>

    </div>
  </div>
</PublicLayout>

