---
import PublicLayout from '../../layouts/PublicLayout.astro';
import { FacultyStaffTable } from '../../components/FacultyStaffTable';
import { getAllStaffMembers, StaffRecord } from '../../lib/supabase';

const breadcrumbs = [
  { label: 'About Us', href: '/about/principals-message/' },
  { label: 'Faculty & Staff' },
];

let staffDirectory: StaffRecord[] = [];
try {
  staffDirectory = await getAllStaffMembers();
} catch (err) {
  console.warn('[faculty-staff.astro] Failed to prefetch staff:', err);
}
---

<PublicLayout
  title="Faculty & Staff | MJ School Shahpur"
  description="Meet the experienced educators, mentors, and academic leadership team guiding scholars at MJ School, Shahpur."
  breadcrumbs={breadcrumbs}
  pageTitle="Our Faculty & Academic Mentors"
  pageSubtitle="Dedicated educators committed to igniting intellect, nurturing compassion, and mentoring future champions."
  pageKey="faculty_staff"
>
  <div class="py-12 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      {/* Faculty Directory Table (Synchronized with Admin Portal) */}
      <FacultyStaffTable client:load initialStaff={staffDirectory} />
    </div>
  </div>
</PublicLayout>

