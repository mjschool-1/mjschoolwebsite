---
import PublicLayout from '../../layouts/PublicLayout.astro';
import { CampusInfrastructureFrame } from '../../components/CampusInfrastructureFrame';

const breadcrumbs = [
  { label: 'About Us', href: '/about/principals-message/' },
  { label: 'Infrastructure' },
];
---

<PublicLayout
  title="Our Campus & Infrastructure | MJ School Shahapur"
  description="Explore the campus environment of MJ School, Shahapur — a thoughtfully planned school where young minds build strong foundations and grow with confidence."
  breadcrumbs={breadcrumbs}
  pageTitle="Our Campus & Infrastructure"
  pageSubtitle="A thoughtfully planned school environment where young minds build strong foundations, discover their interests, and grow with confidence."
  pageKey="infrastructure"
  bannerClass="infrastructure-banner"
  hideBannerText={true}
>
  <div class="pt-8 sm:pt-10 md:pt-12 pb-12 sm:pb-16 bg-white">
    <div class="max-w-[1536px] mx-auto px-4 sm:px-6 lg:px-8">
      
      {/* Relocated Hero Content: Breadcrumb, Main Heading, and Subtitle */}
      <div class="text-center max-w-4xl mx-auto mb-8 sm:mb-10">
        <nav aria-label="Breadcrumb" class="mb-3 sm:mb-4">
          <ol class="flex flex-wrap items-center justify-center gap-2 text-xs sm:text-sm text-slate-600 font-medium">
            <li>
              <a href="/" class="hover:text-[#0B2545] text-slate-500 transition-colors">
                Home
              </a>
            </li>
            {breadcrumbs.map((crumb) => (
              <li class="flex items-center gap-2">
                <span class="text-slate-400 font-bold">→</span>
                {crumb.href ? (
                  <a href={crumb.href} class="hover:text-[#0B2545] text-slate-600 transition-colors">
                    {crumb.label}
                  </a>
                ) : (
                  <span class="text-[#C59B27] font-bold">{crumb.label}</span>
                )}
              </li>
            ))}
          </ol>
        </nav>

        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold font-serif text-[#0B2545] tracking-tight leading-tight">
          Our Campus & Infrastructure
        </h1>

        <p class="mt-3 sm:mt-4 text-sm sm:text-base md:text-lg text-slate-700 max-w-3xl mx-auto leading-relaxed">
          A thoughtfully planned school environment where young minds build strong foundations, discover their interests, and grow with confidence.
        </p>
      </div>

      {/* Campus Infrastructure Image Frame: 1536 × 1024 (Aspect Ratio 3:2) */}
      <CampusInfrastructureFrame client:load />

    </div>
  </div>
</PublicLayout>
