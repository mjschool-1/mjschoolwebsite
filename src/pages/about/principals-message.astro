---
import PublicLayout from '../../layouts/PublicLayout.astro';
import { Quote } from 'lucide-react';

const breadcrumbs = [
  { label: 'About Us', href: '/about/principals-message/' },
  { label: "Head Mistress's Message" },
];
---

<PublicLayout
  title="Head Mistress's Message | MJ School Shahpur"
  description="Read the official address from the Head Mistress of MJ School, Shahpur on academic excellence, value-based pedagogy, and holistic student growth."
  breadcrumbs={breadcrumbs}
  pageTitle="From the Head Mistress's Desk"
  pageSubtitle="Nurturing Future Leaders at MJ School Shahapur"
>
  <div class="py-12 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
        
        {/* Head Mistress Profile Sidebar */}
        <div class="lg:col-span-4 bg-slate-50 border border-slate-200 rounded-2xl overflow-hidden text-center shadow-sm">
          <div class="w-full aspect-[4/3] bg-slate-100">
            <img
              src="/head-mistress.jpeg"
              alt="Head Mistress of MJ School, Shahapur"
              class="w-full h-full block object-cover object-[30%_15%]"
              loading="lazy"
            />
          </div>
          <div class="p-5 sm:p-6">
            <h2 class="text-xl font-bold text-[#0B2545] font-serif">Office of the Head Mistress</h2>
            <p class="text-xs text-[#C59B27] font-bold mt-1 uppercase tracking-wider">MJ SCHOOL, SHAHAPUR</p>

            <div class="mt-5">
              <a
                href="/admissions/2026/"
                class="block w-full text-center bg-[#0B2545] hover:bg-[#133E6E] text-white font-bold py-2.5 px-4 rounded-lg text-xs uppercase tracking-wider transition-colors shadow-sm"
              >
                Admissions 2026-27 Open
              </a>
            </div>
          </div>
        </div>

        {/* Message Body */}
        <div class="lg:col-span-8 space-y-6 text-slate-700 leading-relaxed text-sm sm:text-base">
          
          <div class="bg-amber-50/70 border-l-4 border-[#C59B27] p-5 sm:p-6 rounded-r-xl">
            <p class="text-xs uppercase tracking-wider text-[#C59B27] font-bold mb-1.5 flex items-center gap-1.5">
              <Quote class="w-4 h-4 text-[#C59B27]" />
              <span>From the Headmistress’s Desk</span>
            </p>
            <h3 class="text-xl sm:text-2xl font-bold font-serif text-[#0B2545] leading-snug">
              Nurturing Young Minds, Building Bright Futures
            </h3>
          </div>

          <p class="text-base text-slate-900 font-semibold">
            Dear Parents and Students,
          </p>

          <p>
            At MJ School, Shahapur, we believe every child has the potential to learn, grow, and succeed. Our aim is to provide a supportive learning environment where children build strong academic foundations, develop good values, and discover their unique abilities.
          </p>

          <p>
            We believe that a strong partnership between parents and teachers is essential to every child’s growth. Together, let us help our children become confident, responsible, and compassionate individuals.
          </p>

          <div class="pt-4 border-t border-slate-200 space-y-1">
            <p class="font-bold text-slate-900 text-sm sm:text-base">Warm regards,</p>
            <p class="italic text-slate-700 text-sm sm:text-base">Headmistress</p>
            <p class="text-xs sm:text-sm text-slate-500 font-medium">MJ School, Shahapur</p>
          </div>

        </div>

      </div>

    </div>
  </div>
</PublicLayout>
